{
  "name": "triplette",
  "version": "1.0.0",
  "description": "Triplette — jeu de trios à 3–6 joueurs, chacun sur son téléphone (PWA sans serveur, relais MQTT)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node test/serve.mjs",
    "start": "node test/serve.mjs",
    "test": "node --test test/engine.test.mjs test/net.test.mjs && node test/simulate.mjs 300",
    "e2e": "node test/e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "aedes": "^0.51.3",
    "aedes-server-factory": "^0.2.1",
    "mqtt": "^5.16.1"
  }
}
